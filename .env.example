# ---------------------------------------------------------------
# Pixel-Art Office - environment template
# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# ---------------------------------------------------------------

# --- Database (SQL Server 2025, Windows Authentication) ---------
DATABASE_URL="sqlserver://localhost:1433;database=PixelOffice;integratedSecurity=true;trustServerCertificate=true"

# --- Runtime ----------------------------------------------------
# true = every provider uses offline mock adapters + fixtures (ffmpeg still runs for real)
MOCK_MODE=true
# visible per-stage duration (ms) in mock mode so the Office Floor animations can play out
MOCK_STAGE_MS=4000
# false = pause at Gate 1 and Gate 2 for human approval even in mock mode
MOCK_AUTO_APPROVE=false
# where job artifacts (keyframes, clips, reels) are written
DATA_DIR=./data
# optional: absolute path to your own ffmpeg.exe; defaults to the bundled ffmpeg-static binary
FFMPEG_PATH=

# --- Provider keys (only needed when MOCK_MODE=false) -----------
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
VIDU_API_KEY=
OPENAI_API_KEY=
KLING_API_KEY=

# --- Model IDs (kept out of code; filled in from phase 1 on) ----
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
VEO_MODEL=
VIDU_MODEL=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=

# --- Budget -----------------------------------------------------
BUDGET_CAP_PHP=6000
# PHP per 1 USD
FX_USD_PHP=58
